#!/bin/sh
# What a commit is held to on this machine, and deliberately not more.
#
# Everything here runs over the whole repository in a few seconds, because a
# hook people wait on is a hook people pass `--no-verify` to, and a gate
# nobody runs is worse than no gate at all. So this is style, types and the
# cheap end of the suite. What is not here is what makes `pnpm check` take
# minutes: real git repositories, real PTYs, the tmux driver, the app's frame
# loop. Those are CI's, and `pnpm check` is how you run them here.
#
# Style reads what is staged; types and the tests read the working tree. With
# unstaged edits sitting beside your staged ones, what those passed is not
# byte-for-byte what you are committing — the trade for never stashing your
# work out from under you in the middle of a commit.
#
# Installed by `pnpm hooks`, which `pnpm install` runs for you. Skip one
# commit with `git commit --no-verify`.

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

if [ ! -d node_modules ]; then
  echo "pre-commit: no node_modules — run pnpm install" >&2
  exit 1
fi

step() {
  label=$1
  shift
  if ! "$@"; then
    echo >&2
    echo "pre-commit: $label failed. Fix it, or commit with --no-verify." >&2
    exit 1
  fi
}

# Formatting and lint, including the Grit plugin that enforces R3 — the same
# command CI runs. Only errors are drawn: warnings never fail it, and drawn
# here they were 480KB on every commit, in front of whatever did. `pnpm lint`
# still lists them.
#
# In a commit it reads only the files being committed: several agents share
# one checkout, and over `.` another agent's half-written file failed
# everybody's commit. Style, unlike types, cannot break in a file nobody
# touched. Git sets GIT_INDEX_FILE for the hook, and under `git commit --only`
# that index differs from HEAD in exactly the named paths, not whatever else
# is staged. Tade's checks, given `paths`, run it on the same shape of index:
# HEAD plus those paths (`asCommitOf`, packages/workbench/src/checks.ts). Run
# by hand, or by Tade's checks with no paths, there is no such index, so it
# reads the whole tree.
#
# What it reads of those paths is their staged copies, written out with
# biome's config beside them, not the working tree's: a file half-staged with
# `git add -p` was failed for an edit that was not going in, and passed with
# an untidy copy that was. Out there, with no repository around them, it does
# not ask git what is ignored: every path given to it is being committed.
staged_style() {
  {
    git ls-files -z -- biome.json biome.jsonc biome/
    git diff --cached --name-only -z --diff-filter=d
  } | git checkout-index -f -z --stdin --prefix="$staged/" || return 1
  git diff --cached --name-only -z --diff-filter=d |
    (cd "$staged" && xargs -0 "$root/node_modules/.bin/biome" ci --vcs-enabled=false \
      --diagnostic-level=error --files-ignore-unknown=true --no-errors-on-unmatched --)
}
if [ -n "${GIT_INDEX_FILE:-}" ]; then
  if [ -n "$(git diff --cached --name-only --diff-filter=d)" ]; then
    staged=$(mktemp -d)
    trap 'rm -rf "$staged"' EXIT
    step "style and lint" staged_style
  fi
else
  step "style and lint" pnpm exec biome ci . --diagnostic-level=error
fi

# The whole project, not the staged files: a one-line change in a port breaks
# types in packages nobody touched, which is exactly the breakage worth
# catching before it is pushed.
step "types" pnpm exec tsc -p tsconfig.json

# The smoke end of the suite: the domain — state, config, prompts, speech,
# done rules — plus the tests that hold this repository to its own word: that
# `pnpm check` and the CI workflow Tade reads its checks out of still run the
# same commands, that the guide, the file budgets and the notices are still
# true, and that the R3 lint rule still bites.
step "smoke tests" pnpm run --silent test:smoke
