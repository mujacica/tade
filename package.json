{
  "name": "tade",
  "version": "0.0.0",
  "private": true,
  "description": "A voice-first control room for running coding agents on your own machine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mujacica/tade.git"
  },
  "homepage": "https://github.com/mujacica/tade#readme",
  "bugs": {
    "url": "https://github.com/mujacica/tade/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "check": "biome ci . && tsc -p tsconfig.json && node scripts/coverage.ts",
    "tade": "node packages/cli/src/bin.ts",
    "link:global": "cd packages/cli && pnpm link --global",
    "unlink:global": "pnpm uninstall -g @tade/cli",
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks": "node scripts/install-hooks.mjs --force",
    "test:smoke": "vitest run packages/core/test packages/app/test/pictures.test.ts test/checks-manifest.test.ts test/coverage-floors.test.ts test/lint-rules.test.ts test/modularity.test.ts test/notices.test.ts test/own-files.test.ts",
    "coverage": "node scripts/coverage.ts",
    "screens": "node packages/app/scripts/screens.ts",
    "notices": "node scripts/notices.ts",
    "changelog": "node scripts/release/changelog.ts",
    "stage": "node scripts/release/stage.ts",
    "release": "node scripts/release/release.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
