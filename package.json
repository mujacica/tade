{
  "name": "tade",
  "version": "0.2.3",
  "private": true,
  "description": "A voice-first control room for running coding agents on your own machine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mujacica/tade.git"
  },
  "homepage": "https://tade.sh",
  "bugs": {
    "url": "https://github.com/mujacica/tade/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:related": "node scripts/related.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "check": "biome ci . && tsc -p tsconfig.json && node scripts/coverage.ts",
    "tade": "node packages/cli/src/bin.ts",
    "link:global": "cd packages/cli && pnpm link --global",
    "unlink:global": "pnpm uninstall -g @tade/cli",
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks": "node scripts/install-hooks.mjs --force",
    "test:smoke": "vitest run packages/core/test packages/app/test/pictures.test.ts test/checks-read.test.ts test/coverage-floors.test.ts test/guide.test.ts test/lint-rules.test.ts test/masked.test.ts test/mocked-git.test.ts test/notices.test.ts test/own-files.test.ts test/spawns.test.ts test/swallowed.test.ts",
    "coverage": "node scripts/coverage.ts",
    "screens": "node packages/app/scripts/screens.ts",
    "bench": "node packages/app/scripts/bench.ts",
    "notices": "node scripts/notices.ts",
    "changelog": "node scripts/release/changelog.ts",
    "stage": "node scripts/release/stage.ts",
    "release": "node scripts/release/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
