{
  "name": "tade",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "check": "biome ci . && tsc -p tsconfig.json && vitest run",
    "tade": "node packages/cli/src/bin.ts",
    "link:global": "cd packages/cli && pnpm link --global",
    "unlink:global": "pnpm uninstall -g @tade/cli",
    "postinstall": "node scripts/fix-pty-permissions.mjs && node scripts/install-hooks.mjs",
    "hooks": "node scripts/install-hooks.mjs --force",
    "test:smoke": "vitest run packages/core/test test/checks-manifest.test.ts test/lint-rules.test.ts test/own-files.test.ts",
    "screens": "node packages/app/scripts/screens.ts",
    "notices": "node scripts/notices.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
